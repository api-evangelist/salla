{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/salla/refs/heads/main/json-schema/salla-customer-schema.json",
  "title": "Salla Customer",
  "description": "A customer in a Salla merchant store.",
  "type": "object",
  "required": ["id", "first_name", "mobile", "mobile_code"],
  "properties": {
    "id": { "type": "integer" },
    "first_name": { "type": "string" },
    "last_name": { "type": "string" },
    "mobile": { "type": "string" },
    "mobile_code": { "type": "string", "description": "International dialling prefix, e.g. 966." },
    "email": { "type": "string", "format": "email" },
    "gender": { "type": "string", "enum": ["male", "female"] },
    "birthday": { "type": "string", "format": "date" },
    "avatar": { "type": "string", "format": "uri" },
    "city": { "type": "string" },
    "country": { "type": "string" },
    "currency": { "type": "string" },
    "groups": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
